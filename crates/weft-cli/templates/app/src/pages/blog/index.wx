import type { PageMeta } from "@weft-framework/server";
import { posts } from "../../lib/posts.ts";

export const meta: PageMeta = {
  title: "Blog",
};

component Page() {
  view {
    <h1>Blog</h1>
    <ul>
      {#each posts as post (post.slug)}
        <li><a href={"/blog/" + post.slug}>{post.title}</a> - {post.summary}</li>
      {/each}
    </ul>
  }
}
