import { cn } from "../lib/utils.ts";
client import { copy } from "@weft/ui"

component CodeBlock(code: string, ...attrs: Attrs) {
  view {
    <div class={cn("group/code relative", attrs.class)} {...attrs}>
      <pre class="bg-muted/60 overflow-x-auto rounded-lg border p-4 font-mono text-[13px] leading-6"><code>{code}</code></pre>
      <button type="button" use:copy={code} aria-label="Copy code" class="copy-btn bg-background text-muted-foreground hover:text-foreground absolute top-2.5 right-2.5 rounded-md border px-2 py-1 text-xs opacity-0 transition-opacity group-hover/code:opacity-100 focus-visible:opacity-100 data-[state=copied]:opacity-100">
        <span class="in-data-[state=copied]:hidden">Copy</span>
        <span class="hidden in-data-[state=copied]:inline">Copied</span>
      </button>
    </div>
  }
}
