import { logout, redirect, switchTenant } from "@weft-framework/server";
import { fail } from "@weft-framework/server/action";
import type { Me } from "../lib/workspaces.ts";
import { notify } from "../lib/notify.ts";
import { colorOf, nameOf, initials, userById } from "../lib/users.ts";
import { Icon } from "./Icon.wx";
import { Logo } from "./Logo.wx";
import { ThemeSwitch } from "./ThemeSwitch.wx";
import { type IconName } from "../lib/icons.ts";
import {
  SidebarProvider,
  Sidebar,
  SidebarHeader,
  SidebarContent,
  SidebarGroup,
  SidebarMenu,
  SidebarMenuItem,
  SidebarMenuButton,
  SidebarMenuBadge,
  SidebarFooter,
  SidebarInset,
  SidebarTrigger,
} from "./ui/sidebar.wx";
import { NativeSelect, NativeSelectOption } from "./ui/native-select.wx";

action signOut() {
  await logout(ctx)
  return redirect("/")
}

action changeWorkspace(workspace: string) {
  if (!(await switchTenant(ctx, workspace))) fail("You are not a member of that workspace.")
  return redirect("/app")
}

type Section = { href: string; label: string; icon: IconName; permission?: string };

const WORK: Section[] = [
  { href: "/app", label: "Overview", icon: "home" },
  { href: "/app/tasks", label: "Tasks", icon: "check", permission: "tasks.read" },
  { href: "/app/notes", label: "Notes", icon: "note", permission: "notes.read" },
  { href: "/app/chat", label: "Chat", icon: "chat", permission: "chat.use" },
  { href: "/app/rooms", label: "Rooms", icon: "calendar", permission: "calendar.book" },
];

const WORKSPACE: Section[] = [
  { href: "/app/team", label: "People", icon: "users", permission: "access.members.read" },
  { href: "/app/settings", label: "Workspace settings", icon: "settings", permission: "access.settings.manage" },
];

export function current(path: string, href: string): boolean {
  return href === "/app" ? path === "/app" : path === href || path.startsWith(href + "/");
}

export function allowed(me: Me, sections: Section[]): Section[] {
  return sections.filter((s) => !s.permission || me.can(s.permission as never));
}

component AppShell(me: Me, path: string, title: string, children: Html) {
  client function showConflicts(el: HTMLElement) {
    const list = el.querySelector<HTMLElement>("[data-conflict-list]")
    if (!list) return () => {}
    const secret = /pass|secret|token|code|csrf|otp/i
    const show = (e: Event) => {
      const c = (e as CustomEvent<{ reason: string; form?: Record<string, string>; value?: string }>).detail
      const item = document.createElement("li")
      item.className = "bg-background flex flex-col gap-2 rounded-md border p-3 text-sm shadow-sm"
      const text = document.createElement("p")
      text.textContent = c.reason === "stale"
        ? "A change you made while offline was not saved: someone changed this page first. Check it, then make the change again."
        : "The page reconnected before a change was confirmed. Check that it was saved."
      item.append(text)
      const typed = Object.entries(c.form ?? {}).filter(([k, v]) => v && !secret.test(k)).map(([, v]) => v)
      if (c.value && typed.length === 0) typed.push(c.value)
      for (const v of typed.slice(0, 4)) {
        const q = document.createElement("blockquote")
        q.className = "text-muted-foreground border-l-2 pl-2 whitespace-pre-wrap break-words"
        q.textContent = v.length > 400 ? v.slice(0, 400) + "..." : v
        item.append(q)
      }
      const close = document.createElement("button")
      close.type = "button"
      close.className = "text-muted-foreground hover:text-foreground self-end text-xs underline"
      close.textContent = "Dismiss"
      close.addEventListener("click", () => item.remove())
      item.append(close)
      list.append(item)
      while (list.children.length > 3) list.firstElementChild?.remove()
    }
    document.addEventListener("weft:conflict", show)
    return () => document.removeEventListener("weft:conflict", show)
  }

  view {
    <SidebarProvider>
      <Sidebar label="App" collapsible="offcanvas">
        <SidebarHeader>
          <a href="/" class="flex items-center gap-2 px-2 py-1.5 text-sm font-semibold">
            <Logo class="size-5" />
            {{name}}
          </a>
          {#if me.tenants().length > 0}
            <form action={changeWorkspace} class="px-2 pt-2">
              <label for="workspace-switch" class="text-muted-foreground mb-1 block text-xs">Workspace</label>
              <div class="flex gap-1.5">
                <NativeSelect id="workspace-switch" name="workspace" class="h-8 w-40">
                  {#each me.tenants() as w (w.id)}
                    <NativeSelectOption value={w.id} selected={w.id === me.tenant}>{w.name}</NativeSelectOption>
                  {/each}
                </NativeSelect>
                <button class="hover:bg-sidebar-accent h-8 rounded-md border px-2.5 text-xs font-medium transition-colors">Open</button>
              </div>
            </form>
          {/if}
        </SidebarHeader>
        <SidebarContent>
          {#if me.tenant}
            <SidebarGroup label="Work">
              <SidebarMenu>
                {#each allowed(me, WORK) as s (s.href)}
                  <SidebarMenuItem>
                    <SidebarMenuButton href={s.href} active={current(path, s.href)}>
                      <Icon name={s.icon} />
                      <span>{s.label}</span>
                    </SidebarMenuButton>
                  </SidebarMenuItem>
                {/each}
              </SidebarMenu>
            </SidebarGroup>
            <SidebarGroup label="Workspace">
              <SidebarMenu>
                {#each allowed(me, WORKSPACE) as s (s.href)}
                  <SidebarMenuItem>
                    <SidebarMenuButton href={s.href} active={current(path, s.href)}>
                      <Icon name={s.icon} />
                      <span>{s.label}</span>
                    </SidebarMenuButton>
                  </SidebarMenuItem>
                {/each}
                <SidebarMenuItem>
                  <SidebarMenuButton href="/app/welcome" active={path === "/app/welcome"}>
                    <Icon name="plus" />
                    <span>New workspace</span>
                  </SidebarMenuButton>
                </SidebarMenuItem>
              </SidebarMenu>
            </SidebarGroup>
          {/if}
          <SidebarGroup label="You">
            <SidebarMenu>
              <SidebarMenuItem>
                <SidebarMenuButton href="/app/inbox" active={current(path, "/app/inbox")}>
                  <Icon name="inbox" />
                  <span>Inbox</span>
                </SidebarMenuButton>
                {#if notify.unread(me.id) > 0}
                  <SidebarMenuBadge aria-label={notify.unread(me.id) + " unread"}>{notify.unread(me.id)}</SidebarMenuBadge>
                {/if}
              </SidebarMenuItem>
              <SidebarMenuItem>
                <SidebarMenuButton href="/app/account" active={current(path, "/app/account")}>
                  <Icon name="user" />
                  <span>Account</span>
                </SidebarMenuButton>
              </SidebarMenuItem>
            </SidebarMenu>
          </SidebarGroup>
        </SidebarContent>
        <SidebarFooter>
          <div class="flex items-center gap-2.5 px-2 py-1.5">
            <span aria-hidden="true" class="grid size-8 shrink-0 place-items-center rounded-full text-xs font-semibold text-white" style={"background:" + colorOf(me.id)}>{initials(nameOf(me.id))}</span>
            <span class="min-w-0 flex-1 leading-tight">
              <span class="block truncate text-sm font-medium">{nameOf(me.id)}</span>
              <span class="text-muted-foreground block truncate text-xs">{userById(me.id)?.email}</span>
            </span>
            <form action={signOut}>
              <button class="text-muted-foreground hover:text-foreground hover:bg-sidebar-accent grid size-8 place-items-center rounded-md transition-colors" aria-label="Sign out" title="Sign out">
                <Icon name="logout" />
              </button>
            </form>
          </div>
        </SidebarFooter>
      </Sidebar>
      <SidebarInset>
        <header class="bg-background/90 sticky top-0 z-20 flex h-14 items-center gap-3 border-b px-4 backdrop-blur sm:px-6">
          <SidebarTrigger />
          <h1 class="truncate text-[15px] font-semibold">{title}</h1>
          <div class="ml-auto">
            <ThemeSwitch />
          </div>
        </header>
        <div id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6">{children}</div>
        <div data-weft-ignore use:showConflicts role="status" aria-live="polite" class="fixed right-4 bottom-4 z-50 w-[min(24rem,calc(100vw-2rem))]">
          <ul data-conflict-list class="flex flex-col gap-2"></ul>
        </div>
      </SidebarInset>
    </SidebarProvider>
  }
}
