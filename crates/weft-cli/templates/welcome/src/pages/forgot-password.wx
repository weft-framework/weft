import { redirect, type PageContext } from "@weft-framework/server";
import { fail } from "@weft-framework/server/action";
import { account } from "../lib/accounts.ts";
import { AuthShell } from "../components/AuthShell.wx";
import { buttonVariants } from "../components/ui/button.wx";
import { inputClass } from "../components/ui/input.wx";
import { labelClass } from "../components/ui/label.wx";
import { Field } from "../components/ui/field.wx";

export const meta = { title: "Reset your password" };

export function load(ctx: PageContext) {
  return { sent: ctx.query.get("sent") === "1" };
}

action requestReset(address: string) {
  try {
    await account.requestPasswordReset(ctx, address)
  } catch (err) {
    fail(err instanceof Error && err.name === "AccountError" ? err.message : "Could not send the link. Try again.")
  }
  return redirect("/forgot-password?sent=1")
}

component Page(sent: boolean) {
  view {
    {#if sent}
      <AuthShell title="Check your email" lead="If that address has an account, a link to choose a new password is on its way. It works once, for 30 minutes.">
        <a href="/sign-in" class={buttonVariants({ variant: "outline" })}>Back to sign in</a>
      </AuthShell>
    {:else}
      <AuthShell title="Reset your password" lead="Type the address you signed up with. We will send a link to choose a new password.">
        <form action={requestReset} class="flex flex-col gap-4">
          <Field>
            <label for="address" class={labelClass}>Email</label>
            <input id="address" name="address" type="email" autocomplete="email" required class={inputClass} />
          </Field>
          <p data-weft-message role="alert" class="text-destructive text-sm empty:hidden"></p>
          <button class={buttonVariants({})}>Send the link</button>
        </form>
        <p class="text-muted-foreground mt-10 text-sm">
          Remembered it? <a href="/sign-in" class="text-foreground font-medium underline-offset-4 hover:underline">Sign in</a>
        </p>
      </AuthShell>
    {/if}
  }
}
