import { redirect, type PageContext } from "@weft-framework/server";
import { fail } from "@weft-framework/server/action";
import { account } from "../lib/accounts.ts";
import { AuthShell } from "../components/AuthShell.wx";
import { buttonVariants } from "../components/ui/button.wx";
import { inputClass } from "../components/ui/input.wx";
import { labelClass } from "../components/ui/label.wx";
import { Field, FieldDescription } from "../components/ui/field.wx";

export const meta = { title: "Choose a new password" };

export async function load(ctx: PageContext) {
  const token = ctx.query.get("token") ?? "";
  return { token, valid: token !== "" && (await account.checkResetToken(token)) };
}

action resetPassword(token: string, password: string) {
  let ok = false
  try {
    ok = await account.resetPassword(ctx, token, password)
  } catch (err) {
    fail(err instanceof Error && err.name === "AccountError" ? err.message : "Could not change the password.")
  }
  if (!ok) fail("This link has been used or has expired. Ask for a new one.")
  return redirect("/sign-in?reset=done")
}

component Page(token: string, valid: boolean) {
  view {
    {#if valid}
      <AuthShell title="Choose a new password" lead="After this you will be signed out everywhere; sign in again with the new password.">
        <form action={resetPassword} class="flex flex-col gap-4">
          <input type="hidden" name="token" value={token} />
          <Field>
            <label for="password" class={labelClass}>New password</label>
            <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" required class={inputClass} aria-describedby="password-hint" />
            <FieldDescription id="password-hint">At least 10 characters.</FieldDescription>
          </Field>
          <p data-weft-message role="alert" class="text-destructive text-sm empty:hidden"></p>
          <button class={buttonVariants({})}>Change password</button>
        </form>
      </AuthShell>
    {:else}
      <AuthShell title="This link has expired" lead="Reset links work once, for 30 minutes.">
        <a href="/forgot-password" class={buttonVariants({})}>Get a new link</a>
      </AuthShell>
    {/if}
  }
}
