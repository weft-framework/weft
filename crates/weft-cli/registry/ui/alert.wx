import { cn, variants } from "../../lib/utils.ts";

export const alertVariants = variants(
  "relative w-full rounded-lg border px-4 py-3 text-sm grid has-[>svg]:grid-cols-[calc(var(--spacing)*4)_1fr] grid-cols-[0_1fr] has-[>svg]:gap-x-3 gap-y-0.5 items-start [&>svg]:size-4 [&>svg]:translate-y-0.5 [&>svg]:text-current",
  {
    variant: {
      default: "bg-card text-card-foreground",
      destructive: "text-destructive bg-card [&>svg]:text-current *:data-[slot=alert-description]:text-destructive/90",
    },
  },
  { variant: "default" },
);

component Alert(variant?: "default" | "destructive", children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="alert" role="alert" class={alertVariants({ variant: variant }, attrs.class)} {...attrs}>{children}</div>
  }
}

component AlertTitle(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="alert-title" class={cn("col-start-2 line-clamp-1 min-h-4 font-medium tracking-tight", attrs.class)} {...attrs}>{children}</div>
  }
}

component AlertDescription(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="alert-description" class={cn("text-muted-foreground col-start-2 grid justify-items-start gap-1 text-sm [&_p]:leading-relaxed", attrs.class)} {...attrs}>{children}</div>
  }
}
