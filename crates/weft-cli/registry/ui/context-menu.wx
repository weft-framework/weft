import { cn } from "../../lib/utils.ts";
import { menuContentClass } from "./dropdown-menu.wx";
client import { contextMenu, menu } from "@weft-framework/ui"

component ContextMenu(menu: string, children: Html, ...attrs: Attrs) {
  view {
    <div aria-haspopup="menu" data-slot="context-menu-trigger" class={cn("flex h-[150px] w-[300px] items-center justify-center rounded-md border border-dashed text-sm", attrs.class)} use:contextMenu={menu} {...attrs}>{children}</div>
  }
}

component ContextMenuContent(id: string, children: Html, ...attrs: Attrs) {
  view {
    <div id={id} popover="auto" role="menu" data-slot="context-menu-content" class={cn(menuContentClass, attrs.class)} use:menu {...attrs}>{children}</div>
  }
}
