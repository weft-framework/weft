import { cn, variants } from "../../lib/utils.ts";

export const buttonGroupVariants = variants(
  "flex w-fit items-stretch [&>*]:focus-visible:z-10 [&>*]:focus-visible:relative [&>[data-slot=select-trigger]:not([class*='w-'])]:w-fit [&>input]:flex-1 has-[select[aria-hidden=true]:last-child]:[&>[data-slot=select-trigger]:last-of-type]:rounded-r-md has-[>[data-slot=button-group]]:gap-2",
  {
    orientation: {
      horizontal: "[&>*:not(:first-child)]:rounded-l-none [&>*:not(:first-child)]:border-l-0 [&>*:not(:last-child)]:rounded-r-none",
      vertical: "flex-col [&>*:not(:first-child)]:rounded-t-none [&>*:not(:first-child)]:border-t-0 [&>*:not(:last-child)]:rounded-b-none",
    },
  },
  { orientation: "horizontal" },
);

component ButtonGroup(orientation?: "horizontal" | "vertical", label?: string, children: Html, ...attrs: Attrs) {
  view {
    <div role="group" aria-label={label} data-orientation={orientation ?? "horizontal"} data-slot="button-group" class={buttonGroupVariants({ orientation: orientation }, attrs.class)} {...attrs}>{children}</div>
  }
}

component ButtonGroupText(children: Html, ...attrs: Attrs) {
  view {
    <div class={cn("bg-muted flex items-center gap-2 rounded-md border px-4 text-sm font-medium shadow-xs [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4", attrs.class)} {...attrs}>{children}</div>
  }
}

component ButtonGroupSeparator(orientation?: "horizontal" | "vertical", ...attrs: Attrs) {
  view {
    <div role="separator" aria-orientation={orientation ?? "vertical"} data-slot="button-group-separator" class={cn("bg-input relative !m-0 self-stretch", orientation === "horizontal" ? "h-px w-auto" : "h-auto w-px", attrs.class)} {...attrs}></div>
  }
}
