import { cn } from "../../lib/utils.ts";

export function progressStyle(value: number, max: number): string {
  const pct = max > 0 ? Math.max(0, Math.min(100, (value / max) * 100)) : 0;
  return `transform: translateX(-${100 - pct}%)`;
}

component Progress(value?: number, max?: number, label?: string, ...attrs: Attrs) {
  view {
    <div role="progressbar" aria-label={label} aria-valuemin="0" aria-valuemax={String(max ?? 100)} aria-valuenow={value === undefined ? undefined : String(value)} data-slot="progress" class={cn("bg-primary/20 relative h-2 w-full overflow-hidden rounded-full", attrs.class)} {...attrs}>
      <div data-slot="progress-indicator" class="bg-primary h-full w-full flex-1 transition-all" style={progressStyle(value ?? 0, max ?? 100)}></div>
    </div>
  }
}
