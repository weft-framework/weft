import { cn } from "../../lib/utils.ts";
client import { resizable } from "@weft-framework/ui"

component ResizablePanelGroup(direction?: "horizontal" | "vertical", children: Html, ...attrs: Attrs) {
  view {
    <div data-direction={direction ?? "horizontal"} data-slot="resizable-panel-group" class={cn("flex h-full w-full data-[direction=vertical]:flex-col", attrs.class)} use:resizable {...attrs}>{children}</div>
  }
}

component ResizablePanel(size?: number, minSize?: number, maxSize?: number, children: Html, ...attrs: Attrs) {
  view {
    <div data-size={size === undefined ? undefined : String(size)} data-min-size={minSize === undefined ? undefined : String(minSize)} data-max-size={maxSize === undefined ? undefined : String(maxSize)} data-slot="resizable-panel" class={cn("min-h-0 min-w-0 overflow-hidden", attrs.class)} {...attrs}>{children}</div>
  }
}

component ResizableHandle(label?: string, withHandle?: boolean, ...attrs: Attrs) {
  view {
    <div role="separator" tabindex="0" aria-label={label ?? "Resize"} data-slot="resizable-handle" class={cn("bg-border focus-visible:ring-ring relative flex w-px shrink-0 cursor-col-resize touch-none items-center justify-center select-none after:absolute after:inset-y-0 after:left-1/2 after:w-1 after:-translate-x-1/2 focus-visible:ring-1 focus-visible:ring-offset-1 focus-visible:outline-hidden [[data-direction=vertical]>&]:h-px [[data-direction=vertical]>&]:w-full [[data-direction=vertical]>&]:cursor-row-resize [[data-direction=vertical]>&]:after:left-0 [[data-direction=vertical]>&]:after:h-1 [[data-direction=vertical]>&]:after:w-full [[data-direction=vertical]>&]:after:translate-x-0 [[data-direction=vertical]>&]:after:-translate-y-1/2", attrs.class)} {...attrs}>
      {#if withHandle}
        <div class="bg-border z-10 flex h-4 w-3 items-center justify-center rounded-xs border">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-2.5" aria-hidden="true"><circle cx="9" cy="5" r="1.5" /><circle cx="9" cy="12" r="1.5" /><circle cx="9" cy="19" r="1.5" /><circle cx="15" cy="5" r="1.5" /><circle cx="15" cy="12" r="1.5" /><circle cx="15" cy="19" r="1.5" /></svg>
        </div>
      {/if}
    </div>
  }
}
