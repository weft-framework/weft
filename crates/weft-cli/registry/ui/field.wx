import { cn, variants } from "../../lib/utils.ts";

component FieldSet(children: Html, ...attrs: Attrs) {
  view {
    <fieldset data-slot="field-set" class={cn("flex flex-col gap-6 has-[>[data-slot=checkbox-group]]:gap-3 has-[>[data-slot=radio-group]]:gap-3", attrs.class)} {...attrs}>{children}</fieldset>
  }
}

component FieldLegend(variant?: "legend" | "label", children: Html, ...attrs: Attrs) {
  view {
    <legend data-variant={variant ?? "legend"} data-slot="field-legend" class={cn("mb-3 font-medium data-[variant=legend]:text-base data-[variant=label]:text-sm", attrs.class)} {...attrs}>{children}</legend>
  }
}

component FieldGroup(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="field-group" class={cn("group/field-group @container/field-group flex w-full flex-col gap-7 data-[slot=checkbox-group]:gap-3 [&>[data-slot=field-group]]:gap-4", attrs.class)} {...attrs}>{children}</div>
  }
}

export const fieldVariants = variants(
  "group/field flex w-full gap-3 data-[invalid=true]:text-destructive",
  {
    orientation: {
      vertical: "flex-col [&>*]:w-full [&>.sr-only]:w-auto",
      horizontal: "flex-row items-center [&>[data-slot=field-label]]:flex-auto has-[>[data-slot=field-content]]:items-start",
      responsive: "flex-col [&>*]:w-full [&>.sr-only]:w-auto @md/field-group:flex-row @md/field-group:items-center @md/field-group:[&>*]:w-auto",
    },
  },
  { orientation: "vertical" },
);

component Field(orientation?: "vertical" | "horizontal" | "responsive", invalid?: boolean, children: Html, ...attrs: Attrs) {
  view {
    <div role="group" data-orientation={orientation ?? "vertical"} data-invalid={invalid ? "true" : undefined} data-slot="field" class={fieldVariants({ orientation: orientation }, attrs.class)} {...attrs}>{children}</div>
  }
}

component FieldContent(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="field-content" class={cn("group/field-content flex flex-1 flex-col gap-1.5 leading-snug", attrs.class)} {...attrs}>{children}</div>
  }
}

component FieldLabel(target?: string, children: Html, ...attrs: Attrs) {
  view {
    <label for={target} data-slot="field-label" class={cn("group/field-label peer/field-label flex w-fit items-center gap-2 text-sm leading-snug font-medium select-none group-data-[disabled=true]/field:opacity-50 has-[>[data-slot=field]]:w-full has-[>[data-slot=field]]:flex-col has-[>[data-slot=field]]:rounded-md has-[>[data-slot=field]]:border [&>*]:data-[slot=field]:p-4 has-[:checked]:bg-primary/5 has-[:checked]:border-primary dark:has-[:checked]:bg-primary/10", attrs.class)} {...attrs}>{children}</label>
  }
}

component FieldTitle(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="field-label" class={cn("flex w-fit items-center gap-2 text-sm leading-snug font-medium group-data-[disabled=true]/field:opacity-50", attrs.class)} {...attrs}>{children}</div>
  }
}

component FieldDescription(children: Html, ...attrs: Attrs) {
  view {
    <p data-slot="field-description" class={cn("text-muted-foreground text-sm leading-normal font-normal group-has-[[data-orientation=horizontal]]/field:text-balance [&>a:hover]:text-primary [&>a]:underline [&>a]:underline-offset-4", attrs.class)} {...attrs}>{children}</p>
  }
}

component FieldSeparator(children?: Html, ...attrs: Attrs) {
  view {
    <div data-slot="field-separator" class={cn("relative -my-2 h-5 text-sm", attrs.class)} {...attrs}>
      <div role="separator" class="bg-border absolute inset-x-0 top-1/2 h-px"></div>
      {#if children}
        <span class="bg-background text-muted-foreground relative mx-auto block w-fit px-2">{children}</span>
      {/if}
    </div>
  }
}

component FieldError(message?: string | null, children?: Html, ...attrs: Attrs) {
  view {
    {#if message}
      <div role="alert" data-slot="field-error" class={cn("text-destructive text-sm font-normal", attrs.class)} {...attrs}>{message}</div>
    {:else}
      {#if children}
        <div role="alert" data-slot="field-error" class={cn("text-destructive text-sm font-normal", attrs.class)} {...attrs}>{children}</div>
      {/if}
    {/if}
  }
}
