import { cn } from "../../lib/utils.ts";
import { dialogClass } from "./dialog.wx";
client import { combobox, dialog } from "@weft-framework/ui"

component Command(label?: string, children: Html, ...attrs: Attrs) {
  client function clickPicked(el: HTMLElement) {
    const onChange = (e: Event) => {
      const value = String((e as CustomEvent).detail ?? "")
      const item = [...el.querySelectorAll<HTMLElement>("[role=option]")].find((o) => o.dataset.value === value)
      const target = item?.querySelector<HTMLElement>("a,button") ?? item
      target?.click()
    }
    el.addEventListener("weft:change", onChange)
    return () => el.removeEventListener("weft:change", onChange)
  }

  view {
    <div data-inline="" aria-label={label} data-slot="command" class={cn("bg-popover text-popover-foreground flex h-full w-full flex-col overflow-hidden rounded-md", attrs.class)} use:combobox use:clickPicked {...attrs}>{children}</div>
  }
}

component CommandInput(label?: string, ...attrs: Attrs) {
  view {
    <div data-slot="command-input-wrapper" class="flex h-9 items-center gap-2 border-b px-3">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 opacity-50" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
      <input role="combobox" aria-expanded="true" aria-label={label ?? "Search commands"} autocomplete="off" data-slot="command-input" class={cn("placeholder:text-muted-foreground flex h-10 w-full rounded-md bg-transparent py-3 text-sm outline-hidden disabled:cursor-not-allowed disabled:opacity-50", attrs.class)} {...attrs} />
    </div>
  }
}

component CommandList(children: Html, ...attrs: Attrs) {
  view {
    <div role="listbox" data-slot="command-list" class={cn("max-h-[300px] scroll-py-1 overflow-x-hidden overflow-y-auto", attrs.class)} {...attrs}>{children}</div>
  }
}

component CommandEmpty(children: Html, ...attrs: Attrs) {
  view {
    <div data-weft-empty hidden data-slot="command-empty" class={cn("py-6 text-center text-sm", attrs.class)} {...attrs}>{children}</div>
  }
}

component CommandGroup(heading?: string, children: Html, ...attrs: Attrs) {
  view {
    <div role="group" aria-label={heading} data-slot="command-group" class={cn("text-foreground overflow-hidden p-1", attrs.class)} {...attrs}>
      {#if heading}
        <div aria-hidden="true" class="text-muted-foreground px-2 py-1.5 text-xs font-medium">{heading}</div>
      {/if}
      {children}
    </div>
  }
}

component CommandItem(value: string, href?: string, disabled?: boolean, children: Html, ...attrs: Attrs) {
  view {
    <div role="option" data-value={value} aria-selected="false" aria-disabled={disabled ? "true" : undefined} data-slot="command-item" class={cn("data-[active]:bg-accent data-[active]:text-accent-foreground [&_svg:not([class*='text-'])]:text-muted-foreground relative flex cursor-default items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-hidden select-none aria-disabled:pointer-events-none aria-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4", attrs.class)} {...attrs}>
      {#if href}
        <a href={href} tabindex="-1" class="flex w-full items-center gap-2">{children}</a>
      {:else}
        {children}
      {/if}
    </div>
  }
}

component CommandSeparator(...attrs: Attrs) {
  view {
    <div role="separator" data-slot="command-separator" class={cn("bg-border -mx-1 h-px", attrs.class)} {...attrs}></div>
  }
}

component CommandShortcut(children: Html, ...attrs: Attrs) {
  view {
    <span data-slot="command-shortcut" class={cn("text-muted-foreground ml-auto text-xs tracking-widest", attrs.class)} {...attrs}>{children}</span>
  }
}

component CommandDialog(id: string, title?: string, children: Html, ...attrs: Attrs) {
  view {
    <dialog id={id} aria-label={title ?? "Command palette"} data-slot="command-dialog" class={cn(dialogClass, "overflow-hidden p-0", attrs.class)} use:dialog {...attrs}>
      <Command label={title ?? "Command palette"} class="[&_[data-slot=command-input-wrapper]]:h-12">{children}</Command>
    </dialog>
  }
}
