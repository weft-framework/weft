import { cn } from "../../lib/utils.ts";
import { menuContentClass } from "./dropdown-menu.wx";
client import { menu, menubar, position } from "@weft-framework/ui"

component Menubar(label?: string, children: Html, ...attrs: Attrs) {
  view {
    <div role="menubar" aria-label={label} data-slot="menubar" class={cn("bg-background flex h-9 items-center gap-1 rounded-md border p-1 shadow-xs", attrs.class)} use:menubar {...attrs}>{children}</div>
  }
}

component MenubarTrigger(menu: string, children: Html, ...attrs: Attrs) {
  view {
    <button type="button" role="menuitem" popovertarget={menu} aria-haspopup="menu" data-slot="menubar-trigger" class={cn("focus:bg-accent focus:text-accent-foreground hover:bg-accent flex items-center rounded-sm px-2 py-1 text-sm font-medium outline-hidden select-none", attrs.class)} {...attrs}>{children}</button>
  }
}

component MenubarContent(id: string, children: Html, ...attrs: Attrs) {
  view {
    <div id={id} popover="auto" role="menu" data-slot="menubar-content" class={cn(menuContentClass, "min-w-[12rem]", attrs.class)} use:menu use:position={{ placement: "bottom-start", offset: 8 }} {...attrs}>{children}</div>
  }
}
