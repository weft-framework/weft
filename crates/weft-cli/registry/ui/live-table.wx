import { cn } from "../../lib/utils.ts";
import { Table, TableHeader, TableBody, TableRow, TableHead, TableCell, TableCaption } from "./table.wx";

export interface LiveColumn<T> {
  header: string;
  cell: (row: T) => string | number;
  align?: "left" | "right";
}

component LiveTable<T>(rows: () => T[], key: (row: T) => string | number, columns: LiveColumn<T>[], caption?: string, empty?: string, ...attrs: Attrs) {
  view {
    <div data-slot="live-table" class={cn("w-full", attrs.class)} {...attrs}>
      <Table>
        {#if caption}
          <TableCaption>{caption}</TableCaption>
        {/if}
        <TableHeader>
          <TableRow>
            {#each columns as c}
              <TableHead class={c.align == "right" ? "text-right" : ""}>{c.header}</TableHead>
            {/each}
          </TableRow>
        </TableHeader>
        <TableBody>
          {#each rows() as row (key(row))}
            <TableRow data-key={String(key(row))}>
              {#each columns as c}
                <TableCell class={c.align == "right" ? "text-right tabular-nums" : ""}>{c.cell(row)}</TableCell>
              {/each}
            </TableRow>
          {/each}
          {#if rows().length == 0}
            <TableRow>
              <TableCell colspan={String(columns.length)} class="text-muted-foreground h-16 text-center">{empty ?? "No rows."}</TableCell>
            </TableRow>
          {/if}
        </TableBody>
      </Table>
    </div>
  }
}
