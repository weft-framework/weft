import { cn } from "../../lib/utils.ts";
import { buttonVariants } from "./button.wx";
import type { Placement } from "@weft-framework/ui";
client import { position } from "@weft-framework/ui"

export const popoverClass =
  "bg-popover text-popover-foreground z-50 m-0 w-72 rounded-md border p-4 shadow-md outline-hidden";

component PopoverTrigger(target: string, children: Html, ...attrs: Attrs) {
  view {
    <button type="button" popovertarget={target} aria-haspopup="dialog" data-slot="popover-trigger" class={cn(buttonVariants({ variant: "outline" }), attrs.class)} {...attrs}>{children}</button>
  }
}

component PopoverContent(id: string, placement?: Placement, children: Html, ...attrs: Attrs) {
  view {
    <div id={id} popover="auto" data-slot="popover-content" class={cn(popoverClass, attrs.class)} use:position={{ placement: placement ?? "bottom", offset: 4 }} {...attrs}>{children}</div>
  }
}
