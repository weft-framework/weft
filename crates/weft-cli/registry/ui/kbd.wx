import { cn } from "../../lib/utils.ts";

component Kbd(children: Html, ...attrs: Attrs) {
  view {
    <kbd data-slot="kbd" class={cn("bg-muted text-muted-foreground pointer-events-none inline-flex h-5 w-fit min-w-5 items-center justify-center gap-1 rounded-sm px-1 font-sans text-xs font-medium select-none [&_svg:not([class*='size-'])]:size-3", attrs.class)} {...attrs}>{children}</kbd>
  }
}

component KbdGroup(children: Html, ...attrs: Attrs) {
  view {
    <kbd data-slot="kbd-group" class={cn("inline-flex items-center gap-1", attrs.class)} {...attrs}>{children}</kbd>
  }
}
