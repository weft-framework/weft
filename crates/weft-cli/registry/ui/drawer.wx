import { cn } from "../../lib/utils.ts";
import { buttonVariants } from "./button.wx";
client import { dialog } from "@weft/ui"

component DrawerTrigger(target: string, children: Html, ...attrs: Attrs) {
  view {
    <button type="button" commandfor={target} command="show-modal" aria-haspopup="dialog" data-slot="drawer-trigger" class={cn(buttonVariants({ variant: "outline" }), attrs.class)} {...attrs}>{children}</button>
  }
}

component Drawer(id: string, children: Html, ...attrs: Attrs) {
  view {
    <dialog id={id} aria-labelledby={id + "-title"} aria-describedby={id + "-description"} data-slot="drawer" class={cn("bg-background text-foreground backdrop:bg-black/50 fixed inset-x-0 top-auto bottom-0 z-50 m-0 mt-24 max-h-[80vh] w-full max-w-none flex-col rounded-t-lg border-t p-0 open:flex", attrs.class)} use:dialog {...attrs}>
      <div aria-hidden="true" class="bg-muted mx-auto mt-4 h-2 w-[100px] shrink-0 rounded-full"></div>
      {children}
    </dialog>
  }
}

component DrawerHeader(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="drawer-header" class={cn("flex flex-col gap-0.5 p-4 text-center md:gap-1.5 md:text-left", attrs.class)} {...attrs}>{children}</div>
  }
}

component DrawerFooter(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="drawer-footer" class={cn("mt-auto flex flex-col gap-2 p-4", attrs.class)} {...attrs}>{children}</div>
  }
}

component DrawerTitle(dialog: string, children: Html, ...attrs: Attrs) {
  view {
    <h2 id={dialog + "-title"} data-slot="drawer-title" class={cn("text-foreground font-semibold", attrs.class)} {...attrs}>{children}</h2>
  }
}

component DrawerDescription(dialog: string, children: Html, ...attrs: Attrs) {
  view {
    <p id={dialog + "-description"} data-slot="drawer-description" class={cn("text-muted-foreground text-sm", attrs.class)} {...attrs}>{children}</p>
  }
}

component DrawerClose(target: string, children: Html, ...attrs: Attrs) {
  view {
    <button type="button" commandfor={target} command="close" data-slot="drawer-close" class={cn(buttonVariants({ variant: "outline" }), attrs.class)} {...attrs}>{children}</button>
  }
}
