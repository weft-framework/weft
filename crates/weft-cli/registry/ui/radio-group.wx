import { cn } from "../../lib/utils.ts";

component RadioGroup(label?: string, children: Html, ...attrs: Attrs) {
  view {
    <div role="radiogroup" aria-label={label} data-slot="radio-group" class={cn("grid gap-3", attrs.class)} {...attrs}>{children}</div>
  }
}

component RadioGroupItem(name: string, value: string, ...attrs: Attrs) {
  view {
    <span data-slot="radio-group-item" class="relative inline-flex size-4 shrink-0">
      <input type="radio" name={name} value={value} class={cn("peer border-input text-primary focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:bg-input/30 aspect-square size-4 shrink-0 appearance-none rounded-full border shadow-xs transition-[color,box-shadow] outline-none focus-visible:ring-[3px] disabled:cursor-not-allowed disabled:opacity-50", attrs.class)} {...attrs} />
      <span aria-hidden="true" class="bg-primary pointer-events-none absolute top-1/2 left-1/2 hidden size-2 -translate-x-1/2 -translate-y-1/2 rounded-full peer-checked:block"></span>
    </span>
  }
}
