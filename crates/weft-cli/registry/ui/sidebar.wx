import { cn, variants } from "../../lib/utils.ts";
import { buttonVariants } from "./button.wx";
client import { sidebar } from "@weft-framework/ui"

component SidebarProvider(collapsed?: boolean, children: Html, ...attrs: Attrs) {
  view {
    <div data-state={collapsed ? "collapsed" : "expanded"} data-mobile="closed" data-slot="sidebar-wrapper" class={cn("group/sidebar-wrapper has-data-[variant=inset]:bg-sidebar flex min-h-svh w-full [--sidebar-width:16rem] [--sidebar-width-icon:3rem]", attrs.class)} use:sidebar {...attrs}>{children}</div>
  }
}

component Sidebar(label?: string, side?: "left" | "right", variant?: "sidebar" | "floating" | "inset", collapsible?: "offcanvas" | "icon" | "none", children: Html, ...attrs: Attrs) {
  view {
    <aside aria-label={label} data-side={side ?? "left"} data-variant={variant ?? "sidebar"} data-collapsible={collapsible ?? "offcanvas"} data-slot="sidebar" class={cn("group/sidebar peer text-sidebar-foreground bg-sidebar fixed inset-y-0 z-30 flex h-svh w-(--sidebar-width) flex-col transition-[left,right,width,transform] duration-200 ease-linear data-[side=left]:left-0 data-[side=left]:border-r data-[side=right]:right-0 data-[side=right]:border-l max-md:-translate-x-full max-md:data-[side=right]:translate-x-full max-md:shadow-lg md:sticky md:top-0 group-data-[mobile=open]/sidebar-wrapper:max-md:translate-x-0 md:group-data-[state=collapsed]/sidebar-wrapper:data-[collapsible=offcanvas]:w-0 md:group-data-[state=collapsed]/sidebar-wrapper:data-[collapsible=offcanvas]:overflow-hidden md:group-data-[state=collapsed]/sidebar-wrapper:data-[collapsible=offcanvas]:border-0 md:group-data-[state=collapsed]/sidebar-wrapper:data-[collapsible=icon]:w-(--sidebar-width-icon) data-[variant=floating]:m-2 data-[variant=floating]:h-[calc(100svh-1rem)] data-[variant=floating]:rounded-lg data-[variant=floating]:border data-[variant=floating]:shadow-sm data-[variant=inset]:border-0", attrs.class)} {...attrs}>{children}</aside>
  }
}

component SidebarTrigger(label?: string, ...attrs: Attrs) {
  view {
    <button type="button" data-sidebar-trigger="" aria-label={label ?? "Toggle sidebar"} data-slot="sidebar-trigger" class={cn(buttonVariants({ variant: "ghost", size: "icon" }), "size-7", attrs.class)} {...attrs}>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 3v18" /></svg>
    </button>
  }
}

component SidebarRail(label?: string, ...attrs: Attrs) {
  view {
    <button type="button" tabindex="-1" data-sidebar-trigger="" aria-label={label ?? "Toggle sidebar"} data-slot="sidebar-rail" class={cn("hover:after:bg-sidebar-border absolute inset-y-0 -right-4 z-20 hidden w-4 cursor-w-resize after:absolute after:inset-y-0 after:left-1/2 after:w-[2px] sm:flex", attrs.class)} {...attrs}></button>
  }
}

component SidebarInset(children: Html, ...attrs: Attrs) {
  view {
    <main data-slot="sidebar-inset" class={cn("bg-background relative flex w-full min-w-0 flex-1 flex-col md:peer-data-[variant=inset]:m-2 md:peer-data-[variant=inset]:rounded-xl md:peer-data-[variant=inset]:shadow-sm", attrs.class)} {...attrs}>{children}</main>
  }
}

component SidebarHeader(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="sidebar-header" class={cn("flex flex-col gap-2 p-2", attrs.class)} {...attrs}>{children}</div>
  }
}

component SidebarFooter(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="sidebar-footer" class={cn("flex flex-col gap-2 p-2", attrs.class)} {...attrs}>{children}</div>
  }
}

component SidebarSeparator(...attrs: Attrs) {
  view {
    <div role="separator" data-slot="sidebar-separator" class={cn("bg-sidebar-border mx-2 h-px w-auto", attrs.class)} {...attrs}></div>
  }
}

component SidebarContent(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="sidebar-content" class={cn("flex min-h-0 flex-1 flex-col gap-2 overflow-auto group-data-[collapsible=icon]/sidebar:md:group-data-[state=collapsed]/sidebar-wrapper:overflow-hidden", attrs.class)} {...attrs}>{children}</div>
  }
}

component SidebarGroup(label?: string, children: Html, ...attrs: Attrs) {
  view {
    <div role="group" aria-label={label} data-slot="sidebar-group" class={cn("relative flex w-full min-w-0 flex-col p-2", attrs.class)} {...attrs}>
      {#if label}
        <div aria-hidden="true" data-slot="sidebar-group-label" class="text-sidebar-foreground/70 flex h-8 shrink-0 items-center rounded-md px-2 text-xs font-medium transition-[margin,opacity] duration-200 ease-linear md:group-data-[state=collapsed]/sidebar-wrapper:group-data-[collapsible=icon]/sidebar:-mt-8 md:group-data-[state=collapsed]/sidebar-wrapper:group-data-[collapsible=icon]/sidebar:opacity-0">{label}</div>
      {/if}
      {children}
    </div>
  }
}

component SidebarGroupContent(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="sidebar-group-content" class={cn("w-full text-sm", attrs.class)} {...attrs}>{children}</div>
  }
}

component SidebarMenu(children: Html, ...attrs: Attrs) {
  view {
    <ul data-slot="sidebar-menu" class={cn("flex w-full min-w-0 flex-col gap-1", attrs.class)} {...attrs}>{children}</ul>
  }
}

component SidebarMenuItem(children: Html, ...attrs: Attrs) {
  view {
    <li data-slot="sidebar-menu-item" class={cn("group/menu-item relative", attrs.class)} {...attrs}>{children}</li>
  }
}

export const sidebarMenuButtonVariants = variants(
  "peer/menu-button flex w-full items-center gap-2 overflow-hidden rounded-md p-2 text-left text-sm outline-hidden ring-sidebar-ring transition-[width,height,padding] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 active:bg-sidebar-accent active:text-sidebar-accent-foreground disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50 aria-[current=page]:bg-sidebar-accent aria-[current=page]:font-medium aria-[current=page]:text-sidebar-accent-foreground md:group-data-[state=collapsed]/sidebar-wrapper:group-data-[collapsible=icon]/sidebar:size-8! md:group-data-[state=collapsed]/sidebar-wrapper:group-data-[collapsible=icon]/sidebar:p-2! [&>span:last-child]:truncate [&>svg]:size-4 [&>svg]:shrink-0",
  {
    variant: {
      default: "hover:bg-sidebar-accent hover:text-sidebar-accent-foreground",
      outline: "bg-background shadow-[0_0_0_1px_hsl(var(--sidebar-border))] hover:bg-sidebar-accent hover:text-sidebar-accent-foreground hover:shadow-[0_0_0_1px_hsl(var(--sidebar-accent))]",
    },
    size: {
      default: "h-8 text-sm",
      sm: "h-7 text-xs",
      lg: "h-12 text-sm",
    },
  },
  { variant: "default", size: "default" },
);

component SidebarMenuButton(href?: string, active?: boolean, variant?: "default" | "outline", size?: "default" | "sm" | "lg", children: Html, ...attrs: Attrs) {
  view {
    {#if href}
      <a href={href} aria-current={active ? "page" : undefined} data-slot="sidebar-menu-button" class={sidebarMenuButtonVariants({ variant: variant, size: size }, attrs.class)} {...attrs}>{children}</a>
    {:else}
      <button type="button" data-slot="sidebar-menu-button" class={sidebarMenuButtonVariants({ variant: variant, size: size }, attrs.class)} {...attrs}>{children}</button>
    {/if}
  }
}

component SidebarMenuBadge(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="sidebar-menu-badge" class={cn("text-sidebar-foreground pointer-events-none absolute right-1 top-1.5 flex h-5 min-w-5 items-center justify-center rounded-md px-1 text-xs font-medium tabular-nums select-none md:group-data-[state=collapsed]/sidebar-wrapper:group-data-[collapsible=icon]/sidebar:hidden", attrs.class)} {...attrs}>{children}</div>
  }
}

component SidebarMenuSub(children: Html, ...attrs: Attrs) {
  view {
    <ul data-slot="sidebar-menu-sub" class={cn("border-sidebar-border mx-3.5 flex min-w-0 translate-x-px flex-col gap-1 border-l px-2.5 py-0.5 md:group-data-[state=collapsed]/sidebar-wrapper:group-data-[collapsible=icon]/sidebar:hidden", attrs.class)} {...attrs}>{children}</ul>
  }
}

component SidebarMenuSubItem(children: Html, ...attrs: Attrs) {
  view {
    <li data-slot="sidebar-menu-sub-item" class={cn("group/menu-sub-item relative", attrs.class)} {...attrs}>{children}</li>
  }
}

component SidebarMenuSubButton(href: string, active?: boolean, children: Html, ...attrs: Attrs) {
  view {
    <a href={href} aria-current={active ? "page" : undefined} data-slot="sidebar-menu-sub-button" class={cn("text-sidebar-foreground ring-sidebar-ring hover:bg-sidebar-accent hover:text-sidebar-accent-foreground active:bg-sidebar-accent aria-[current=page]:bg-sidebar-accent aria-[current=page]:text-sidebar-accent-foreground flex h-7 min-w-0 -translate-x-px items-center gap-2 overflow-hidden rounded-md px-2 text-sm outline-hidden focus-visible:ring-2 [&>span:last-child]:truncate [&>svg]:size-4 [&>svg]:shrink-0", attrs.class)} {...attrs}>{children}</a>
  }
}
