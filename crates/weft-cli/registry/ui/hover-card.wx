import { cn } from "../../lib/utils.ts";
import type { Placement } from "@weft-framework/ui";
client import { hoverCard } from "@weft-framework/ui"

component HoverCardTrigger(card: string, href?: string, children: Html, ...attrs: Attrs) {
  view {
    {#if href}
      <a href={href} data-slot="hover-card-trigger" class={cn("underline-offset-4 hover:underline", attrs.class)} use:hoverCard={card} {...attrs}>{children}</a>
    {:else}
      <span tabindex="0" data-slot="hover-card-trigger" class={cn(attrs.class)} use:hoverCard={card} {...attrs}>{children}</span>
    {/if}
  }
}

component HoverCardContent(id: string, placement?: Placement, children: Html, ...attrs: Attrs) {
  view {
    <div id={id} popover="manual" data-placement={placement ?? "bottom"} data-slot="hover-card-content" class={cn("bg-popover text-popover-foreground z-50 m-0 w-64 rounded-md border p-4 shadow-md outline-hidden", attrs.class)} {...attrs}>{children}</div>
  }
}
