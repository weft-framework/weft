import { cn } from "../../lib/utils.ts";

component Card(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="card" class={cn("bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm", attrs.class)} {...attrs}>{children}</div>
  }
}

component CardHeader(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="card-header" class={cn("@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-1.5 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6", attrs.class)} {...attrs}>{children}</div>
  }
}

component CardTitle(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="card-title" class={cn("leading-none font-semibold", attrs.class)} {...attrs}>{children}</div>
  }
}

component CardDescription(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="card-description" class={cn("text-muted-foreground text-sm", attrs.class)} {...attrs}>{children}</div>
  }
}

component CardAction(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="card-action" class={cn("col-start-2 row-span-2 row-start-1 self-start justify-self-end", attrs.class)} {...attrs}>{children}</div>
  }
}

component CardContent(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="card-content" class={cn("px-6", attrs.class)} {...attrs}>{children}</div>
  }
}

component CardFooter(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="card-footer" class={cn("flex items-center px-6 [.border-t]:pt-6", attrs.class)} {...attrs}>{children}</div>
  }
}
