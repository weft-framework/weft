import { cn, variants } from "../../lib/utils.ts";

component Empty(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="empty" class={cn("flex min-w-0 flex-1 flex-col items-center justify-center gap-6 rounded-lg border-dashed p-6 text-center text-balance md:p-12", attrs.class)} {...attrs}>{children}</div>
  }
}

component EmptyHeader(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="empty-header" class={cn("flex max-w-sm flex-col items-center gap-2 text-center", attrs.class)} {...attrs}>{children}</div>
  }
}

export const emptyMediaVariants = variants(
  "mb-2 flex shrink-0 items-center justify-center [&_svg]:pointer-events-none [&_svg]:shrink-0",
  {
    variant: {
      default: "bg-transparent",
      icon: "bg-muted text-foreground flex size-10 shrink-0 items-center justify-center rounded-lg [&_svg:not([class*='size-'])]:size-6",
    },
  },
  { variant: "default" },
);

component EmptyMedia(variant?: "default" | "icon", children: Html, ...attrs: Attrs) {
  view {
    <div data-variant={variant ?? "default"} data-slot="empty-icon" class={emptyMediaVariants({ variant: variant }, attrs.class)} {...attrs}>{children}</div>
  }
}

component EmptyTitle(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="empty-title" class={cn("text-lg font-medium tracking-tight", attrs.class)} {...attrs}>{children}</div>
  }
}

component EmptyDescription(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="empty-description" class={cn("text-muted-foreground [&>a:hover]:text-primary text-sm/relaxed [&>a]:underline [&>a]:underline-offset-4", attrs.class)} {...attrs}>{children}</div>
  }
}

component EmptyContent(children: Html, ...attrs: Attrs) {
  view {
    <div data-slot="empty-content" class={cn("flex w-full max-w-sm min-w-0 flex-col items-center gap-4 text-sm text-balance", attrs.class)} {...attrs}>{children}</div>
  }
}
