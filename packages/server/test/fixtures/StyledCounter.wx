component Counter(start: number = 0, step: number = 1) {
  signal count = start
  derived doubled = count * 2
  derived hue = (((count * 40) % 360) + 360) % 360

  function increment() { count = count + step }
  function decrement() { count = count - step }
  function reset() { count = start }

  view {
    <div class="counter">
      <button class="step" @click={decrement} aria-label="Decrease">&minus;</button>
      <output>{count}</output>
      <button class="step" @click={increment} aria-label="Increase">+</button>

      <p class="hint">doubled is {doubled}</p>
      <button class="reset" @click={reset} disabled={count === start}>Reset</button>
    </div>
  }

  style {
    .counter {
      display: grid;
      grid-template-columns: auto auto auto;
      gap: 0.75rem 1rem;
      align-items: center;
      justify-content: center;
    }
    output {
      font-size: 2.5rem;
      font-variant-numeric: tabular-nums;
      text-align: center;
      color: hsl({hue} 70% 45%);
    }
    .step {
      width: 3rem;
      height: 3rem;
      font-size: 1.25rem;
      border: 2px solid hsl({hue} 70% 45%);
      border-radius: 0.5rem;
      background: white;
    }
    .step:hover { background: hsl({hue} 70% 95%); }
    .hint { grid-column: 1 / -1; text-align: center; color: #666; margin: 0; }
    .reset { grid-column: 1 / -1; }
    .reset:disabled { opacity: 0.4; cursor: default; }
  }
}
